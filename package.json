{
  "name": "dte-pdf-kit",
  "version": "0.5.2",
  "description": "Kit de diseño PDF del DTE para @react-pdf/renderer -- tokens, tipografía y componentes reutilizables entre apps con identidad DTE.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:assets": "node scripts/build-assets.mjs",
    "build": "npm run build:assets && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "pretest": "npm run build && node scripts/build-test-fixtures.mjs",
    "test": "node --test 'tests/*.test.mjs'"
  },
  "peerDependencies": {
    "@react-pdf/renderer": "^4.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "fontkit": "^2.0.4"
  },
  "devDependencies": {
    "@react-pdf/renderer": "^4.9.0",
    "@react-pdf/types": "^2.14.0",
    "@types/fontkit": "^2.0.8",
    "@types/react": "^19.2.8",
    "esbuild": "^0.24.2",
    "react": "^19.2.8",
    "typescript": "^5.7.3"
  }
}
